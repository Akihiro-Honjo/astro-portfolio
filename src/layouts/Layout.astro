---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
	 <link rel="stylesheet" href="/src/styles/tailwind.css" />
    <style>
      nav {
        background: #007acc;
        color: white;
        padding: 1rem;
      }
      nav a {
        color: white;
        margin-right: 1rem;
        text-decoration: none;
      }
      nav a:hover {
        text-decoration: underline;
      }
      main {
        padding: 2rem;
        background: #f9f9f9;
        min-height: 80vh;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <!-- <a href="/about">About</a> -->
      <a href="#projects">Projects</a>
    </nav>
    <main>
      <slot />
    </main>
 </body>
</html>
